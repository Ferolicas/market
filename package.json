{
  "name": "market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:assets": "node scripts/validate-market-assets.mjs",
    "qa:accessories": "node scripts/qa-accessory-runtime.mjs",
    "qa:customers": "node scripts/qa-customer-runtime.mjs",
    "qa:character-performance": "node scripts/qa-character-lod-cart.mjs",
    "qa:avatar-panel": "node scripts/qa-avatar-panel.mjs",
    "qa:workers": "node scripts/qa-worker-runtime.mjs",
    "qa:campaign-rework": "node scripts/qa-campaign-rework.mjs",
    "qa:mobile-render": "node scripts/qa-mobile-render-budget.mjs",
    "qa:production-surface": "node scripts/qa-production-surface.mjs",
    "qa:save-lost-ack": "node scripts/qa-save-lost-ack.mjs",
    "qa:webgl-recovery": "node scripts/qa-webgl-recovery.mjs",
    "qa:campaign-reach": "tsx scripts/qa-campaign-reach.mts",
    "qa:seed-state": "tsx scripts/qa-seed-state.mts",
    "load:test:game": "node scripts/load-test-game-api.mjs",
    "art:manifest": "tsx scripts/write-reference-manifest.ts",
    "art:lods": "node scripts/build-market-lods.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "godot:run": "godot --path godot",
    "godot:test": "bash godot/tools/test.sh",
    "godot:export:web": "node scripts/export-godot.mjs Web",
    "godot:export:linux": "node scripts/export-godot.mjs Linux",
    "godot:qa:api": "node scripts/qa-godot-live-api.mjs",
    "godot:qa:web": "MARKET_QA_WEB=1 MARKET_QA_JOURNEY=1 MARKET_QA_PANELS=1 MARKET_QA_CONTEXT=1 MARKET_QA_TOUCH=1 MARKET_QA_LIFECYCLE=1 node scripts/qa-godot-live-api.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
