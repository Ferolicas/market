    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recast-navigation": "0.43.1",
    "resend": "^6.22.1",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "troika-three-text": "^0.52.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
