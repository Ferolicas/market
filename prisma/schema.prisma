generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id
  name            String
  email           String        @unique
  emailVerified   Boolean       @default(false)
  image           String?
  username        String?       @unique
  displayUsername String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        Session[]
  accounts        Account[]
  profile         PlayerProfile?
  saves           GameSave[]
  saveOperations  SaveOperation[]
  clientTelemetry ClientTelemetry[]
  transactions    LedgerEntry[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PlayerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  countryCode String   @default("ES")
  currency    String   @default("EUR")
  avatarSkin  String   @default("caramel")
  avatarShirt String   @default("mint")
  avatarHat   String   @default("red-panda")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameSave {
  id        String   @id @default(cuid())
  userId    String
  slot      Int      @default(1)
  revision  Int      @default(1)
  state     Json
  checksum  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@index([userId, updatedAt])
}

/// Durable idempotency receipt for a save request. A client can safely retry
/// the exact operation after losing the HTTP response without turning its own
/// successful write into a revision conflict.
model SaveOperation {
  operationId    String   @id
  userId         String
  slot           Int      @default(1)
  expectedRevision Int
  appliedRevision  Int
  deviceId       String
  sessionId      String
  stateChecksum  String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, slot, appliedRevision])
}

/// Sanitised field diagnostics from authenticated game clients. Payloads are
/// bounded at the API and retained only long enough to diagnose releases.
model ClientTelemetry {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  name      String
  severity  String
  message   String?
  route     String?
  deviceId  String?
  sessionId String?
  payload   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind, name, createdAt])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  userId      String
  saveRevision Int
  day         Int
  franchiseId String
  category    String
  description String
  amountMinor BigInt
  currency    String
  eventId     String?
  sessionId   String?
  sequence    Int?
  type        String?
  payload     Json?
  idempotencyKey String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@index([userId, franchiseId])
  @@index([userId, eventId])
  @@unique([userId, idempotencyKey])
}

/// Shared fixed-window limiter for authenticated API operations. One row is
/// reused per user/scope, so the table remains bounded by active callers.
model ApiRateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("api_rate_limit_bucket")
}
